# Copy to .env.local and fill in. Never commit .env.local (it is gitignored).

# Neon (serverless Postgres) — use the POOLED connection string (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Resend API key. With this set, each signup's email is saved as a Resend contact.
# Confirmation emails stay dormant until launch (see src/lib/resend.ts).
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Public base URL for canonical links, the OpenGraph image, sitemap, and robots.
# Optional — defaults to https://lastlap.vercel.app (src/lib/content.ts). Set per environment
# to override (e.g. a Vercel preview URL).
NEXT_PUBLIC_SITE_URL="https://lastlap.vercel.app"
